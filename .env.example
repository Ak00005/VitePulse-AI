# =================================================================
# VitaPulse AI — Environment Configuration Template
# DO NOT ADD REAL PASSWORDS OR API KEYS TO THIS FILE
# Copy this file to .env and insert your real credentials locally
# =================================================================

# Server Port (Local Development)
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=production

# MongoDB Atlas Connection URI (REQUIRED)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/lifestyle_ai?retryWrites=true&w=majority

# Legacy Mongo URI alias (Supported for backward compatibility)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/lifestyle_ai?retryWrites=true&w=majority

# JWT Authentication Secret Key (REQUIRED)
# Generate a strong random string (e.g. openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_key_change_in_production

# Google Gemini API Key for VitaPulse AI Assistant (REQUIRED for chat feature)
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Standalone Python ML Inference Service URL (REQUIRED for decoupled ML architecture)
# Example Local: http://localhost:8000
# Example Production: https://vitapulse-ml.onrender.com or https://<app-name>.railway.app
ML_SERVICE_URL=http://localhost:8000

# Frontend Custom Domain (Optional for CORS if deployed separately)
FRONTEND_URL=https://vitapulse-ai.vercel.app

# Frontend API URL (Optional for Vite client if API is on a separate domain)
VITE_API_URL=

